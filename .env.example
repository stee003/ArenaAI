# JobProof production environment variables
# Do not expose secret keys in the browser. Use these only in serverless/API routes.

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# AI provider - choose one
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
GEMINI_API_KEY=your-gemini-key

# Stripe
STRIPE_SECRET_KEY=sk_live_or_test
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_or_test
JOBPROOF_STARTER_PRICE_ID=price_starter
JOBPROOF_PRO_PRICE_ID=price_pro
JOBPROOF_BETA_SETUP_PRICE_ID=price_beta_setup

# Email
RESEND_API_KEY=re_your_key
LEAD_NOTIFICATION_FROM=JobProof <leads@yourdomain.com>

# App
VITE_APP_URL=https://yourdomain.com
